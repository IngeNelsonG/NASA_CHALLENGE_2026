{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "git": { "deploymentEnabled": { "main": false } },
  "functions": {
    "api/index.py": {
      "maxDuration": 120,
      "includeFiles": "backend/{src,data}/**",
      "excludeFiles": "{node_modules/**,dist/**,public/**,src/**,scripts/**,backend/tests/**,backend/scripts/**,backend/.venv/**,**/__pycache__/**,.vercel_python_packages/**,_uv/**}"
    }
  },
  "rewrites": [{ "source": "/api/:path*", "destination": "/api/index?__path=:path*" }],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/textures/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    }
  ]
}
