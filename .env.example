# Connect directly to the real FastAPI NASA FIRMS backend
VITE_USE_MOCKS=false
# Empty uses Vite's /api proxy (http://127.0.0.1:8000) in dev/preview.
# On Vercel leave it empty: the API is served by the same project under /api (api/index.py).
# Only set it if the API is hosted elsewhere (origin without trailing slash).
VITE_API_URL=
